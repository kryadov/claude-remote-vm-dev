# Copy to rd.env and fill in. rd.env is gitignored (holds environment-specific values).
#
# --- Laptop-side: how to reach the VM (used by ./connect.sh, ./bootstrap-remote.sh) ---
VM_IP="10.0.0.10"                 # private IP of your VM
VM_USER="ubuntu"                  # SSH login user
SSH_KEY="$HOME/.ssh/dev-vm.pem"   # path to your private key

# --- Repo delivery: used by ./bootstrap-remote.sh to clone onto the VM ---
REPO_URL="https://<your-forge-host>/<you>/claude-remote-dev.git"
# Read-only token for the FIRST clone only. The credential prefix follows the
# forge: GitLab uses oauth2:<token>, GitHub uses x-access-token:<token>.
#   GitLab (scope: read_repository):
#     glab api --method POST "projects/<ns>%2F<repo>/access_tokens" \
#       -H "Content-Type: application/json" --input - <<< \
#       '{"name":"vm-clone-readonly","scopes":["read_repository"],"access_level":20,"expires_at":"YYYY-MM-DD"}'
#   GitHub: a fine-grained PAT with Contents: Read on the repository.
# Leave empty to clone via SSH / an already-configured credential helper instead.
GIT_CLONE_TOKEN=""

# --- Which forge REPO_URL lives on (blank = infer from the host) ---
# A host whose name contains 'github' or 'gitlab' is detected automatically;
# set this explicitly for a self-hosted host named after neither.
FORGE=""

# --- VM-side: which model provider new sessions use by default ---
# vertex | bedrock | anthropic
# Override per session:  rd-start <project> --provider bedrock
RD_PROVIDER="vertex"

# --- Provider: GCP Vertex (consumed by bootstrap.sh) ---
GCP_PROJECT_ID="your-vertex-project-id"
CLOUD_ML_REGION="global"

# --- Provider: Amazon Bedrock ---
# Set AWS_REGION to enable this provider, then pick ONE credential path.
# AWS_PROFILE (SSO) is preferred — no long-lived secret on the VM; refresh it
# with: rd-auth --provider bedrock
AWS_REGION=""
AWS_PROFILE=""
AWS_BEARER_TOKEN_BEDROCK=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""
# Without pins, 'opus'/'sonnet' resolve to Claude Code's built-in Bedrock
# defaults, which may not be enabled in your account — pin what you have.
ANTHROPIC_DEFAULT_OPUS_MODEL=""
ANTHROPIC_DEFAULT_SONNET_MODEL=""
ANTHROPIC_DEFAULT_HAIKU_MODEL=""

# --- Provider: direct Anthropic API ---
# Leave empty to use a Claude subscription instead: rd-auth runs
# `claude setup-token` and stores the OAuth token outside this file.
ANTHROPIC_API_KEY=""

# --- VM-side: commit author for git on the VM (required by rd-auth) ---
# Without these, commits made on the VM are attributed to <user>@<hostname>.
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL="you@example.com"
