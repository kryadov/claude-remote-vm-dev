#!/usr/bin/env bash
# List Claude Code sessions with project, session, state, branch, and dir.
#
#   rd-list                  running tmux sessions, human table
#   rd-list --all            also stopped worktree sessions (no tmux session)
#   rd-list --porcelain      tab-separated rows for scripts (rd-tui uses this)
#
# Porcelain columns: state, project, session, branch, dir, created (epoch),
# provider. 'created' and 'provider' are empty for stopped sessions — there is
# no tmux session to ask. Provider is appended last so older readers that stop
# at 'created' keep working.
set -euo pipefail

usage() {
  echo "usage: rd-list [--all] [--porcelain]" >&2
  exit 2
}

ALL=0
PORCELAIN=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --all) ALL=1; shift ;;
    --porcelain) PORCELAIN=1; shift ;;
    *) usage ;;
  esac
done

fmt=$'#{session_name}\t#{@rd_project}\t#{@rd_session}\t#{session_created}\t#{?session_attached,attached,detached}\t#{pane_current_path}\t#{@rd_provider}'
running="$(tmux list-sessions -F "$fmt" 2>/dev/null | grep -E '^claude-' || true)"

rows=()
seen=()

branch_of() {
  git -C "$1" branch --show-current 2>/dev/null || true
}

while IFS=$'\t' read -r name project rd_session created state path provider; do
  [[ -n "$name" ]] || continue
  if [[ -z "$project" ]]; then
    # Legacy session created before metadata was stored on the tmux session.
    project="${name#claude-}"
    rd_session="default"
  fi
  rd_session="${rd_session:-default}"
  seen+=("$project/$rd_session")
  rows+=("$state"$'\t'"$project"$'\t'"$rd_session"$'\t'"$(branch_of "$path")"$'\t'"$path"$'\t'"$created"$'\t'"${provider:-}")
done <<< "$running"

if [[ "$ALL" -eq 1 ]]; then
  shopt -s nullglob
  for dir in "$HOME"/worktrees/*/*; do
    [[ -d "$dir" && -e "$dir/.git" ]] || continue
    session="$(basename "$dir")"
    project="$(basename "$(dirname "$dir")")"
    key="$project/$session"
    known=0
    if [[ ${#seen[@]} -gt 0 ]]; then
      for entry in "${seen[@]}"; do
        [[ "$entry" == "$key" ]] && { known=1; break; }
      done
    fi
    [[ "$known" -eq 0 ]] || continue
    rows+=("stopped"$'\t'"$project"$'\t'"$session"$'\t'"$(branch_of "$dir")"$'\t'"$dir"$'\t'$'\t')
  done
  shopt -u nullglob
fi

if [[ ${#rows[@]} -eq 0 ]]; then
  [[ "$PORCELAIN" -eq 1 ]] || echo "No Claude sessions found."
  exit 0
fi

sorted="$(printf '%s\n' "${rows[@]}" | LC_ALL=C sort -t$'\t' -k2,2 -k3,3)"

if [[ "$PORCELAIN" -eq 1 ]]; then
  printf '%s\n' "$sorted"
  exit 0
fi

printf '%-18s %-18s %-9s %-17s %-10s %-24s %s\n' PROJECT SESSION STATE CREATED PROVIDER BRANCH DIR
while IFS=$'\t' read -r state project session branch dir created provider; do
  [[ -n "$state" ]] || continue
  if [[ -n "$created" ]]; then
    when="$(date -d "@$created" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "$created")"
  else
    when="-"
  fi
  printf '%-18s %-18s %-9s %-17s %-10s %-24s %s\n' \
    "$project" "$session" "$state" "$when" "${provider:--}" "${branch:--}" "$dir"
done <<< "$sorted"
