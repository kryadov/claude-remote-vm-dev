#!/usr/bin/env bash
# One-time authorizations for a remote-dev VM, in one command:
#   model provider (Vertex ADC | Bedrock | Anthropic) + forge (glab | gh)
#   + Git author + Jira reminder.
#
# Usage: rd-auth [--provider vertex|bedrock|anthropic] [--forge gitlab|github] [<forge-host>]
#
# The provider defaults to ~/.config/rd/provider (written by bootstrap.sh from
# RD_PROVIDER in rd.env); the forge is inferred from REPO_URL unless FORGE says
# otherwise. Credentials live in ~/.config/rd/providers/<name>.env at 0600 —
# never in rd.env, which is copied from the laptop.
set -euo pipefail

usage() {
  echo "usage: rd-auth [--provider vertex|bedrock|anthropic] [--forge gitlab|github] [<forge-host>]" >&2
  exit 2
}

# Read a simple KEY=value entry from rd.env without executing the file.
read_env_value() {
  local key="$1" file="$2" value
  value="$(grep -E "^${key}=" "$file" | head -1 | cut -d= -f2-)" || true
  value="${value%$'\r'}"
  case "$value" in
    \"*\"|\'*\') value="${value:1:${#value}-2}" ;;
  esac
  printf '%s' "$value"
}

PROVIDER=""
FORGE=""
FORGE_HOST=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --provider) [[ $# -ge 2 ]] || usage; PROVIDER="$2"; shift 2 ;;
    --forge)    [[ $# -ge 2 ]] || usage; FORGE="$2"; shift 2 ;;
    --*)        usage ;;
    *)          [[ -z "$FORGE_HOST" ]] || usage; FORGE_HOST="$1"; shift ;;
  esac
done

# Pick up the forge host and Git author from rd.env in the repo checkout.
ENV_FILE=""
# Git matches a credential helper by scheme AND host, so an https-scoped helper
# is simply never consulted for an http:// remote. Follow whatever REPO_URL
# uses; https stays the default when there is nothing to read.
FORGE_SCHEME="https"
for envf in "$HOME"/*/rd.env "$HOME/rd.env"; do
  [[ -f "$envf" ]] || continue
  url="$(read_env_value REPO_URL "$envf")"
  [[ -n "$url" ]] || continue
  ENV_FILE="$envf"
  case "$url" in http://*) FORGE_SCHEME="http" ;; esac
  if [[ -z "$FORGE_HOST" ]]; then
    FORGE_HOST="$(echo "$url" | sed -E 's#https?://([^/]+)/.*#\1#')"
  fi
  break
done

GIT_USER_NAME=""
GIT_USER_EMAIL=""
if [[ -n "$ENV_FILE" ]]; then
  GIT_USER_NAME="$(read_env_value GIT_USER_NAME "$ENV_FILE")"
  GIT_USER_EMAIL="$(read_env_value GIT_USER_EMAIL "$ENV_FILE")"
fi
if [[ -z "$GIT_USER_NAME" || -z "$GIT_USER_EMAIL" ]]; then
  echo "Git author is not configured. Set both values in rd.env:" >&2
  echo '  GIT_USER_NAME="Your Name"' >&2
  echo '  GIT_USER_EMAIL="you@example.com"' >&2
  exit 1
fi

# --- 1/3  Model provider ------------------------------------------------------

RD_CONFIG_DIR="${RD_CONFIG_DIR:-$HOME/.config/rd}"
PROVIDER_DIR="$RD_CONFIG_DIR/providers"
if [[ -z "$PROVIDER" ]]; then
  PROVIDER="$(cat "$RD_CONFIG_DIR/provider" 2>/dev/null || true)"
  PROVIDER="${PROVIDER%%$'\n'*}"
  PROVIDER="${PROVIDER:-vertex}"
fi
PROVIDER_FILE="$PROVIDER_DIR/$PROVIDER.env"

# The provider file is shell, but it is only ever read here — never sourced —
# so a malformed line cannot take the auth run down with it.
provider_has() {
  [[ -r "$PROVIDER_FILE" ]] &&
    grep -qE "^[[:space:]]*(export[[:space:]]+)?$1=" "$PROVIDER_FILE"
}
provider_value() {
  local value
  value="$(grep -E "^[[:space:]]*(export[[:space:]]+)?$1=" "$PROVIDER_FILE" \
    | head -1 | cut -d= -f2-)"
  value="${value%$'\r'}"
  case "$value" in
    \"*\"|\'*\') value="${value:1:${#value}-2}" ;;
  esac
  printf '%s' "$value"
}

echo "== 1/3  Model provider: $PROVIDER =="
case "$PROVIDER" in
  vertex)
    if gcloud auth application-default print-access-token >/dev/null 2>&1; then
      echo "   Vertex ADC already authenticated ✓"
    else
      gcloud auth application-default login --no-launch-browser
    fi
    ;;
  bedrock)
    if provider_has AWS_PROFILE; then
      aws_profile="$(provider_value AWS_PROFILE)"
      if aws sts get-caller-identity --profile "$aws_profile" >/dev/null 2>&1; then
        echo "   AWS profile '$aws_profile' already valid ✓"
      else
        aws sso login --profile "$aws_profile"
      fi
    elif provider_has AWS_BEARER_TOKEN_BEDROCK || provider_has AWS_ACCESS_KEY_ID; then
      echo "   Bedrock uses a static credential from $PROVIDER_FILE — nothing to log in ✓"
    else
      echo "rd-auth: $PROVIDER_FILE has no AWS_PROFILE, AWS_BEARER_TOKEN_BEDROCK" >&2
      echo "         or AWS_ACCESS_KEY_ID. Set one in rd.env and re-run bootstrap.sh." >&2
      exit 1
    fi
    ;;
  anthropic)
    if provider_has ANTHROPIC_API_KEY || provider_has CLAUDE_CODE_OAUTH_TOKEN; then
      echo "   Anthropic credential already present in $PROVIDER_FILE ✓"
    else
      echo "   Subscription login — authorize the URL, then the token is stored for you."
      token="$(claude setup-token | tail -1 | tr -d '[:space:]')"
      if [[ -z "$token" ]]; then
        echo "rd-auth: 'claude setup-token' returned no token" >&2
        exit 1
      fi
      mkdir -p "$PROVIDER_DIR"
      umask 077
      printf 'export CLAUDE_CODE_OAUTH_TOKEN=%s\n' "$token" >> "$PROVIDER_FILE"
      chmod 600 "$PROVIDER_FILE"
      echo "   OAuth token stored in $PROVIDER_FILE (0600) ✓"
    fi
    ;;
  *)
    echo "rd-auth: unknown provider '$PROVIDER' (expected vertex, bedrock or anthropic)" >&2
    exit 2
    ;;
esac

# --- 2/3  Forge + Git author --------------------------------------------------

echo "== 2/3  Forge login + Git author =="
if [[ -z "$FORGE_HOST" ]]; then
  read -rp "   Forge host (e.g. gitlab.example.com): " FORGE_HOST
fi
if [[ -z "$FORGE" && -n "$ENV_FILE" ]]; then
  FORGE="$(read_env_value FORGE "$ENV_FILE")"
fi
if [[ -z "$FORGE" ]]; then
  case "$FORGE_HOST" in
    *github*) FORGE="github" ;;
    *gitlab*) FORGE="gitlab" ;;
    # A host named after neither cannot be told apart — ask, or say so plainly
    # when there is nobody to ask.
    *)
      if [[ -t 0 ]]; then
        read -rp "   Is $FORGE_HOST GitLab or GitHub? [gitlab/github] " FORGE
      else
        echo "rd-auth: cannot tell whether '$FORGE_HOST' is GitLab or GitHub." >&2
        echo "         Pass --forge gitlab|github, or set FORGE in rd.env." >&2
        exit 2
      fi
      ;;
  esac
fi

# A global glab helper answers for GitHub hosts too and breaks every GitHub
# push, so migrate any legacy one to a host-scoped helper.
legacy_helper="$(git config --global --get credential.helper 2>/dev/null || true)"
if [[ "$legacy_helper" == '!glab auth git-credential' ]]; then
  git config --global --unset credential.helper
  echo "   migrated the legacy global glab credential helper ✓"
fi

case "$FORGE" in
  gitlab)
    # Scoped, and no pipeline: `glab auth status` without --hostname exits
    # non-zero when ANY configured instance fails (a stale gitlab.com entry is
    # enough), and under `set -o pipefail` that sent us into a pointless
    # re-login even though this host was fine.
    if glab auth status --hostname "$FORGE_HOST" >/dev/null 2>&1; then
      echo "   already logged in to $FORGE_HOST ✓"
    else
      echo "   Create a token (scope: api), then choose 'Token' and paste it:"
      echo "   $FORGE_SCHEME://$FORGE_HOST/-/user_settings/personal_access_tokens?name=remote-dev-vm&scopes=api"
      glab auth login --hostname "$FORGE_HOST"
    fi
    git config --global "credential.$FORGE_SCHEME://$FORGE_HOST.helper" '!glab auth git-credential'
    ;;
  github)
    if gh auth status --hostname "$FORGE_HOST" >/dev/null 2>&1; then
      echo "   already logged in to $FORGE_HOST ✓"
    else
      echo "   Create a token (scopes: repo, read:org), then choose 'Token' and paste it:"
      echo "   $FORGE_SCHEME://$FORGE_HOST/settings/tokens/new?scopes=repo,read:org&description=remote-dev-vm"
      gh auth login --hostname "$FORGE_HOST"
    fi
    gh auth setup-git --hostname "$FORGE_HOST"
    ;;
  *)
    echo "rd-auth: unknown forge '$FORGE' (expected gitlab or github)" >&2
    exit 2
    ;;
esac
echo "   git credentials scoped to $FORGE_SCHEME://$FORGE_HOST ✓"

git config --global user.name "$GIT_USER_NAME"
git config --global user.email "$GIT_USER_EMAIL"
printf '   commit author: %s <%s> ✓\n' "$GIT_USER_NAME" "$GIT_USER_EMAIL"

# --- 3/3  Jira ----------------------------------------------------------------

echo "== 3/3  Jira / Confluence (Atlassian plugin) =="
echo "   Run 'claude' and trigger a Jira action once; authorize the OAuth URL in your browser."

echo
echo "Done. Start a NEW project:   rd-start <project> <git-url>"
echo "     or continue existing:   rd-start <project>"
echo "     on another provider:    rd-start <project> --provider bedrock"
