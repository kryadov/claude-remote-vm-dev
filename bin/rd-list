#!/usr/bin/env bash
# List Claude Code sessions with project, session, state, branch, and dir.
#
#   rd-list                  running tmux sessions, human table
#   rd-list --all            also stopped worktree sessions (no tmux session)
#   rd-list --porcelain      tab-separated rows for scripts (rd-tui uses this)
#
# Porcelain columns: state, project, session, branch, dir, created (epoch),
# provider, activity (idle/busy/exited, from rd-claude-hook), claude (the
# release the session started), update ('outdated' when that differs from the
# installed release). Everything after 'dir' is empty for stopped sessions —
# there is no tmux session to ask. New columns are appended so older readers
# that stop earlier keep working.
set -euo pipefail

usage() {
  echo "usage: rd-list [--all] [--porcelain]" >&2
  exit 2
}

ALL=0
PORCELAIN=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --all) ALL=1; shift ;;
    --porcelain) PORCELAIN=1; shift ;;
    *) usage ;;
  esac
done

# Rows are split on \x1f, not a tab: `read` collapses runs of whitespace
# separators, which would shift every column after an empty field (a legacy
# session has no provider). tmux itself must still emit tabs — it escapes
# control characters such as \x1f to a literal "\037" in format output.
US=$'\x1f'
fmt=$'#{session_name}\t#{@rd_project}\t#{@rd_session}\t#{session_created}\t#{?session_attached,attached,detached}\t#{pane_current_path}\t#{@rd_provider}\t#{@rd_claude_state}\t#{@rd_claude_version}'
running="$(tmux list-sessions -F "$fmt" 2>/dev/null | grep -E '^claude-' || true)"
running="${running//$'\t'/$US}"
installed="$(claude --version 2>/dev/null | awk 'NR == 1 { print $1 }' || true)"

rows=()
seen=()

branch_of() {
  git -C "$1" branch --show-current 2>/dev/null || true
}

while IFS="$US" read -r name project rd_session created state path provider activity version; do
  [[ -n "$name" ]] || continue
  if [[ -z "$project" ]]; then
    # Legacy session created before metadata was stored on the tmux session.
    project="${name#claude-}"
    rd_session="default"
  fi
  rd_session="${rd_session:-default}"
  seen+=("$project/$rd_session")
  update=""
  if [[ -n "$installed" && -n "$version" && "$version" != "$installed" ]]; then
    update="outdated"
  fi
  rows+=("$state"$'\t'"$project"$'\t'"$rd_session"$'\t'"$(branch_of "$path")"$'\t'"$path"$'\t'"$created"$'\t'"${provider:-}"$'\t'"${activity:-}"$'\t'"${version:-}"$'\t'"$update")
done <<< "$running"

if [[ "$ALL" -eq 1 ]]; then
  shopt -s nullglob
  for dir in "$HOME"/worktrees/*/*; do
    [[ -d "$dir" && -e "$dir/.git" ]] || continue
    session="$(basename "$dir")"
    project="$(basename "$(dirname "$dir")")"
    key="$project/$session"
    known=0
    if [[ ${#seen[@]} -gt 0 ]]; then
      for entry in "${seen[@]}"; do
        [[ "$entry" == "$key" ]] && { known=1; break; }
      done
    fi
    [[ "$known" -eq 0 ]] || continue
    rows+=("stopped"$'\t'"$project"$'\t'"$session"$'\t'"$(branch_of "$dir")"$'\t'"$dir"$'\t'$'\t'$'\t'$'\t'$'\t')
  done
  shopt -u nullglob
fi

if [[ ${#rows[@]} -eq 0 ]]; then
  [[ "$PORCELAIN" -eq 1 ]] || echo "No Claude sessions found."
  exit 0
fi

sorted="$(printf '%s\n' "${rows[@]}" | LC_ALL=C sort -t$'\t' -k2,2 -k3,3)"

if [[ "$PORCELAIN" -eq 1 ]]; then
  printf '%s\n' "$sorted"
  exit 0
fi

printf '%-18s %-18s %-9s %-9s %-17s %-10s %-10s %-24s %s\n' \
  PROJECT SESSION STATE ACTIVITY CREATED PROVIDER CLAUDE BRANCH DIR
any_outdated=0
while IFS= read -r line; do
  IFS="$US" read -r state project session branch dir created provider activity version update \
    <<< "${line//$'\t'/$US}"
  [[ -n "$state" ]] || continue
  if [[ -n "$created" ]]; then
    when="$(date -d "@$created" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "$created")"
  else
    when="-"
  fi
  if [[ "$update" == "outdated" ]]; then
    version="$version*"
    any_outdated=1
  fi
  printf '%-18s %-18s %-9s %-9s %-17s %-10s %-10s %-24s %s\n' \
    "$project" "$session" "$state" "${activity:--}" "$when" "${provider:--}" \
    "${version:--}" "${branch:--}" "$dir"
done <<< "$sorted"
if [[ "$any_outdated" -eq 1 ]]; then
  echo
  echo "* older than the installed Claude $installed — move a session with: rd-restart <project> [--session <name>]"
fi
